{
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "partitions.csv"
    },
    "core": "esp32",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "extra_flags": [
      "-D ARDUINO_ESP32S3_DEV",
      "-D ARDUINO_USB_MODE=1",
      "-D ARDUINO_RUNNING_CORE=1",
      "-D ARDUINO_EVENT_RUNNING_CORE=1",
      "-D CONFIG_ESP32_ENABLE_COREDUMP_TO_FLASH=1",
      "-D CONFIG_ESP32_COREDUMP_DATA_FORMAT_ELF=1",
      "-D CONFIG_SPIRAM_SUPPORT=1",
      "-D CONFIG_SPIRAM=1",
      "-D BOARD_HAS_PSRAM=1",
      "-D CONFIG_SPIRAM_MODE_OCT=1",
      "-D CONFIG_SPIRAM_SPEED_80M=1",
      "-D CONFIG_PM_ENABLE=1",
      "-D CONFIG_PM_DFS_INIT_AUTO=1"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "flash_size": "16MB",
    "psram_type": "opi",
    "memory_type": "qio_opi"
  },
  "connectivity": [
    "wifi",
    "bluetooth",
    "ble"
  ],
  "debug": {
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": [
    "arduino"
  ],
  "name": "Custom ESP32-S3 Board",
  "upload": {
    "maximum_ram_size": 8388608,
    "maximum_size": 16777216,
    "speed": 921600
  },
  "url": "https://www.kulib88.com",
  "vendor": "JLC PCB"
}